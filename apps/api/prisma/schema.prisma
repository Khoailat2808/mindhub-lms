generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                     @id @default(autoincrement())
  username             String                  @unique
  email                String                  @unique
  passwordHash         String                  @map("password_hash")
  fullName             String                  @map("full_name")
  role                 String
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  assignedLessons      LearningPath[]          @relation("LearningPathStudent")
  createdLearningPaths LearningPath[]          @relation("LearningPathAssigner")
  lessonProgress       StudentLessonProgress[]
  streak               Streak?
  studentProfile       StudentProfile?
  assignmentSubmissions AssignmentSubmission[]
  lessonNotes           StudentLessonNote[]
  notifications         Notification[]
  scheduleItems         ScheduleItem[]
  createdAssignments    Assignment[]            @relation("AssignmentCreator")
  courseEnrollments     CourseStudent[]          @relation("CourseStudent")
  assignedCourseStudents CourseStudent[]         @relation("CourseStudentAssigner")

  @@index([role])
  @@map("users")
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  courses   Course[]
  assignments Assignment[]

  @@map("subjects")
}

model Course {
  id          Int      @id @default(autoincrement())
  subjectId   Int?     @map("subject_id")
  title       String
  description String?
  teacherName String?  @map("teacher_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  assignments Assignment[]
  scheduleItems ScheduleItem[]
  enrollments CourseStudent[]

  @@index([subjectId])
  @@index([teacherName])
  @@map("courses")
}

model CourseStudent {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  studentId  Int      @map("student_id")
  assignedBy Int?     @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation("CourseStudent", fields: [studentId], references: [id])
  assigner   User?    @relation("CourseStudentAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([assignedBy])
  @@map("course_students")
}

model Lesson {
  id              Int                     @id @default(autoincrement())
  courseId        Int                     @map("course_id")
  title           String
  description     String?
  videoType       String?                 @map("video_type")
  videoUrl        String?                 @map("video_url")
  videoFilePath   String?                 @map("video_file_path")
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  course          Course                  @relation(fields: [courseId], references: [id])
  questions       Question[]
  materials       LessonMaterial[]
  learningPaths   LearningPath[]
  studentProgress StudentLessonProgress[]
  assignments     Assignment[]
  studentNotes    StudentLessonNote[]
  scheduleItems   ScheduleItem[]

  @@index([courseId])
  @@index([isActive])
  @@map("lessons")
}

model Question {
  id            Int      @id @default(autoincrement())
  lessonId      Int      @map("lesson_id")
  questionType  String   @map("question_type")
  content       String?
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")
  imageOriginalName String? @map("image_original_name")
  imageMimeType String?  @map("image_mime_type")
  optionA       String?  @map("option_a")
  optionB       String?  @map("option_b")
  optionC       String?  @map("option_c")
  optionD       String?  @map("option_d")
  correctAnswer String   @map("correct_answer")
  explanation   String?
  score         Int?     @default(1)
  orderIndex    Int      @default(1) @map("order_index")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lesson        Lesson   @relation(fields: [lessonId], references: [id])

  @@map("questions")
}

model LessonMaterial {
  id           Int      @id @default(autoincrement())
  lessonId     Int      @map("lesson_id")
  originalName String   @map("original_name")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")
  lesson       Lesson   @relation(fields: [lessonId], references: [id])

  @@map("lesson_materials")
}

model LearningPath {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  lessonId   Int      @map("lesson_id")
  orderIndex Int      @map("order_index")
  assignedBy Int      @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  student    User     @relation("LearningPathStudent", fields: [studentId], references: [id])
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  assigner   User     @relation("LearningPathAssigner", fields: [assignedBy], references: [id])

  @@unique([studentId, lessonId])
  @@unique([studentId, orderIndex])
  @@index([lessonId])
  @@map("learning_paths")
}

model StudentLessonProgress {
  id             Int       @id @default(autoincrement())
  studentId      Int       @map("student_id")
  lessonId       Int       @map("lesson_id")
  completed      Boolean   @default(false)
  score          Int?
  totalQuestions Int?      @map("total_questions")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  student        User      @relation(fields: [studentId], references: [id])
  lesson         Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([studentId, completed])
  @@map("student_lesson_progress")
}

model Streak {
  id                Int       @id @default(autoincrement())
  studentId         Int       @unique @map("student_id")
  currentStreak     Int       @default(0) @map("current_streak")
  longestStreak     Int       @default(0) @map("longest_streak")
  lastCompletedDate DateTime? @map("last_completed_date")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  student           User      @relation(fields: [studentId], references: [id])

  @@map("streaks")
}

model StudentProfile {
  id             Int      @id @default(autoincrement())
  studentId      Int      @unique @map("student_id")
  avatarUrl      String?  @map("avatar_url")
  grade          String?
  schoolName     String?  @map("school_name")
  learningGoals  String?  @map("learning_goals")
  targetScore    String?  @map("target_score")
  preferredSubjects String? @map("preferred_subjects")
  parentPhone    String?  @map("parent_phone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  student        User     @relation(fields: [studentId], references: [id])

  @@map("student_profiles")
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        String   @default("assignment")
  subjectId   Int?     @map("subject_id")
  courseId    Int?     @map("course_id")
  lessonId    Int?     @map("lesson_id")
  deadline    DateTime?
  maxScore    Int?     @map("max_score")
  createdBy   Int      @map("created_by")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  subject     Subject? @relation(fields: [subjectId], references: [id])
  course      Course?  @relation(fields: [courseId], references: [id])
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])
  creator     User     @relation("AssignmentCreator", fields: [createdBy], references: [id])
  submissions AssignmentSubmission[]
  questions   AssignmentQuestion[]

  @@index([courseId])
  @@index([lessonId])
  @@index([createdBy])
  @@index([deadline])
  @@map("assignments")
}

model AssignmentQuestion {
  id            Int      @id @default(autoincrement())
  assignmentId  Int      @map("assignment_id")
  questionType  String   @map("question_type")
  content       String?
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")
  imageOriginalName String? @map("image_original_name")
  imageMimeType String?  @map("image_mime_type")
  optionA       String?  @map("option_a")
  optionB       String?  @map("option_b")
  optionC       String?  @map("option_c")
  optionD       String?  @map("option_d")
  correctAnswer String   @map("correct_answer")
  explanation   String?
  score         Int?     @default(1)
  orderIndex    Int      @default(1) @map("order_index")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_questions")
}

model AssignmentSubmission {
  id           Int       @id @default(autoincrement())
  assignmentId Int       @map("assignment_id")
  studentId    Int       @map("student_id")
  status       String    @default("not_started")
  answerText   String?   @map("answer_text")
  score        Int?
  feedback     String?
  startedAt    DateTime? @map("started_at")
  submittedAt  DateTime? @map("submitted_at")
  gradedAt     DateTime? @map("graded_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

model StudentLessonNote {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  lessonId  Int      @map("lesson_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  student   User     @relation(fields: [studentId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
  @@map("student_lesson_notes")
}

model Notification {
  id        Int       @id @default(autoincrement())
  studentId Int       @map("student_id")
  title     String
  content   String
  type      String    @default("info")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  student   User      @relation(fields: [studentId], references: [id])

  @@index([studentId, readAt])
  @@map("notifications")
}

model ScheduleItem {
  id        Int       @id @default(autoincrement())
  studentId Int       @map("student_id")
  courseId  Int?      @map("course_id")
  lessonId  Int?      @map("lesson_id")
  title     String
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  location  String?
  status    String    @default("scheduled")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  student   User      @relation(fields: [studentId], references: [id])
  course    Course?   @relation(fields: [courseId], references: [id])
  lesson    Lesson?   @relation(fields: [lessonId], references: [id])

  @@index([studentId, startsAt])
  @@map("schedule_items")
}
