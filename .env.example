# Runtime
NODE_ENV=development

# API
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindhub?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN="http://localhost:3000"

# Uploads
UPLOAD_VIDEO_DIR="uploads/videos"
UPLOAD_MATERIAL_DIR="uploads/materials"
UPLOAD_QUESTION_IMAGE_DIR="uploads/question-images"
MAX_VIDEO_UPLOAD_MB=100
MAX_MATERIAL_UPLOAD_MB=20
MAX_LESSON_MATERIALS_TOTAL_MB=50
MAX_QUESTION_IMAGE_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="mindhub/question-images"

# Seed admin account. Change before deploying publicly.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@mindhub.test"
ADMIN_PASSWORD="Admin@12345"

# Web
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
